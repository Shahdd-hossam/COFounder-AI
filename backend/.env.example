DB_ECHO=false
DEMO_OWNER_ID=demo-owner
MCP_ENABLED=false
GMAIL_ENABLED=false
MCP_SERVER_NAME=Tavily
MCP_RESEARCH_TOOL=tavily_research
MCP_CLI_PATH=manus-mcp-cli
MCP_TIMEOUT_SECONDS=90
MANUS_ENABLED=false
MANUS_API_KEY=
MANUS_API_BASE_URL=https://api.manus.ai
MANUS_TIMEOUT_SECONDS=180
MANUS_POLL_INTERVAL_SECONDS=4
