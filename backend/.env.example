APP_NAME=CoFounder AI API
APP_VERSION=0.2.0
API_PREFIX=/api/v1
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]
DATABASE_URL=sqlite:///./cofounder_ai.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
